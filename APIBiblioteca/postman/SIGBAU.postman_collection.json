          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/configuracion/actualiza",
            "body": { "mode": "raw", "raw": "{\"diasMaxPrestamo\":-1,\"limitePrestamos\":0,\"multaPorDia\":-5,\"schedulerActivo\":true,\"notifEmail\":false,\"alertaStock\":true,\"modoMant\":false}" }
